#usda 1.0

def Xform "simple_environment"
{
    reorder xformOp order = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    uniform token[] xformOp:order = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    
    xformOp:translate = (0, 0, 0)
    xformOp:rotateXYZ = (0, 0, 0)
    xformOp:scale = (1, 1, 1)

    def Scope "floor"
    {
        def Cube "floor_cube"
        {
            double3 size = (10.0, 10.0, 0.1)
            double3 xformOp:translate = (0, 0, -0.05)
            uniform token[] xformOp:order = ["xformOp:translate", "xformOp:scale"]
            xformOp:scale = (1, 1, 1)
            color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
        }
    }

    def Sphere "light"
    {
        double3 xformOp:translate = (5, 5, 5)
        uniform token[] xformOp:order = ["xformOp:translate"]
        float radius = 0.1
        color3f[] primvars:displayColor = [(1.0, 1.0, 1.0)]
    }
}
