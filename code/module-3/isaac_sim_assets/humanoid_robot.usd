#usda 1.0

def Xform "humanoid_robot"
{
    reorder xformOp order = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    uniform token[] xformOp:order = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    
    xformOp:translate = (0, 0, 0)
    xformOp:rotateXYZ = (0, 0, 0)
    xformOp:scale = (1, 1, 1)

    def Scope "body"
    {
        def Sphere "head"
        {
            float radius = 0.1
            color3f[] primvars:displayColor = [(0.8, 0.2, 0.2)]
            double3 xformOp:translate = (0, 0, 0.6)
            uniform token[] xformOp:order = ["xformOp:translate"]
        }

        def Cylinder "torso"
        {
            float height = 0.5
            float radius = 0.15
            color3f[] primvars:displayColor = [(0.2, 0.2, 0.8)]
            double3 xformOp:translate = (0, 0, 0.25)
            uniform token[] xformOp:order = ["xformOp:translate"]
        }
    }
}
