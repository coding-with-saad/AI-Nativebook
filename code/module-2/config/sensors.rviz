# RViz configuration for sensor visualization

Global Options:
  Fixed Frame: base_link
  Background Color: 48; 58; 72
  Frame Rate: 30

Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Color: 150; 150; 150
    Cell Size: 1
    Line Style: 0
    Normal Cell Count: 0
    Offset Z: 0
    Plane: XY
    Render at 0: true

  - Class: rviz_default_plugins/LaserScan
    Name: LiDAR Scan
    Topic: /scan
    Color: 0; 255; 0
    Size (m): 0.05
    Style: Points

  - Class: rviz_default_plugins/Image
    Name: Depth Image
    Topic: /depth/image_raw
    Transport Hint: raw
    Normalize Range: true

  - Class: rviz_default_plugins/Imu
    Name: IMU
    Topic: /imu
    Covariance Type: 0
    Arrow Scale: 0.5
    Orientation: true
    Linear Acceleration: true
    Angular Velocity: true

Panels:
  - Class: rviz_default_plugins/Displays
    Name: Displays
  - Class: rviz_default_plugins/Property
    Name: Property
  - Class: rviz_default_plugins/Views
    Name: Views
  - Class: rviz_default_plugins/Tool Properties
    Name: Tool Properties
